# Snowflake key-pair auth (scripts/sf_query.py, and the app's run_census_sql
# at request time). Never commit the private key or a filled-in .env.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
# Snapshot builder (src/snapshot.py, issue #2) — optional, defaults to
# data/snapshot.sqlite3 (matches the Docker Compose "data" volume mount).
SNAPSHOT_DB_PATH=
