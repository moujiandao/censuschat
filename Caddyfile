# Mirror of the intended production gate (D-034). Production does not use
# this file: Caddy runs natively on the host from /etc/caddy/Caddyfile
# (D-016). Reads are public; any other method needs the login, and the
# app's same-origin guard (src/same_origin.py) refuses cross-site writes.
{$DOMAIN:censuschat.brianmar.com} {
	@writes not method GET HEAD OPTIONS
	basic_auth @writes {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	reverse_proxy app:8000 {
		# Disables Caddy's response buffering interval — required for SSE.
		# Cloudflare's own buffering is a separate concern, checked in #10.
		flush_interval -1
	}
}
