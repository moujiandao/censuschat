# Snowflake key-pair auth (scripts/sf_query.py, and the app's run_census_sql
# at request time). Never commit the private key or a filled-in .env.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_ROLE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
# Snapshot builder (src/snapshot.py, issue #2) — optional, defaults to
# data/snapshot.sqlite3 (matches the Docker Compose "data" volume mount).
SNAPSHOT_DB_PATH=

# Session store (src/sessions.py, issue #8) — optional, defaults to
# data/sessions.sqlite3 (same Docker Compose "data" volume mount).
SESSION_DB_PATH=

# Anthropic (src/agent.py, issue #7) — Sonnet tool loop. Resolved via SDK
# default precedence: ANTHROPIC_API_KEY, then ANTHROPIC_AUTH_TOKEN, then an
# `ant auth login` profile. Never commit a real key.
ANTHROPIC_API_KEY=
